# Linux 桌面入口（M6-01，DEC-017）。Exec 指向 /opt/aki 自包含安装目录
#（CPACK_PACKAGING_INSTALL_PREFIX；assets 与可执行文件同级，见
# cmake/Packaging.cmake 布局说明）。图标经 hicolor 主题解析（deb 内
# /usr/share/icons/hicolor/256x256/apps/aki.png）。
[Desktop Entry]
Type=Application
Name=Aki
Comment=Cross-device instant messaging client
Exec=/opt/aki/aki
Icon=aki
Terminal=false
Categories=Network;InstantMessaging;
# DEC-024：平台适配层在创建窗口前将 Wayland app_id 和 X11 WM_CLASS
# 均设为 aki，与本 desktop 文件名一致，供 Dock 图标与窗口分组匹配。
StartupWMClass=aki
